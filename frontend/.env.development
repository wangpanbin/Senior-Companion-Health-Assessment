# ==========================================================================
# 开发环境变量（Vite 只暴露 VITE_ 前缀的变量给前端代码）
# ==========================================================================

# 应用标题
VITE_APP_TITLE=银龄伴诊

# 前端 dev server 端口
# 注意：5173 落在 Windows 被 Hyper-V/WSL2 保留的排除端口段（5152-5251）内，
# 非管理员进程绑定会报 EACCES，故改用 5141。
VITE_PORT=5141

# 后端地址（用于 vite 代理）
VITE_API_TARGET=http://localhost:8080

# 接口基础路径（axios baseURL）
VITE_API_BASE_URL=/api

# 是否开启调试日志
VITE_ENABLE_DEBUG=true
