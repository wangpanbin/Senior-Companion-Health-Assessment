# ==========================================================================
# 开发环境变量（Vite 只暴露 VITE_ 前缀的变量给前端代码）
# ==========================================================================

# 应用标题
VITE_APP_TITLE=银龄伴诊

# 前端 dev server 端口
# 注意：5173 落在 Windows 被 Hyper-V/WSL2 保留的排除端口段（5152-5251）内，
# 非管理员进程绑定会报 EACCES，故改用 5141。
VITE_PORT=5141

# 后端地址（用于 vite 代理）
VITE_API_TARGET=http://localhost:8080

# 接口基础路径（axios baseURL）
VITE_API_BASE_URL=/api

# 是否开启调试日志
VITE_ENABLE_DEBUG=true

# --------------------------------------------------------------------------
# 百度地图 AK（ADR-0022，家属端订单详情 / 陪诊员打卡页的实时位置地图）
#
# ⚠️ 这里只留空占位，真值请写到 `frontend/.env.development.local`
#    （`.gitignore` 的 `*.local` 已忽略，不会入库）。
#
# 申请步骤：
#   1. https://lbsyun.baidu.com/ → 登录 → 控制台 →（首次需要开发者认证，免费、个人即时通过）
#      → 应用管理 → 我的应用 → 创建应用
#   2. 应用类型选「**浏览器端**」（服务端 AK 不能给 JSAPI 用）
#      启用服务勾选「JavaScript API」
#   3. Referer 白名单：本地调试填 `*`，或 `localhost:5141,127.0.0.1:5141`；
#      上线改成真实域名。白名单比实际访问域名窄会报 status:220，表现为地图一片灰。
#   4. 复制「访问应用（AK）」→ 写进 `.env.development.local`：
#      VITE_BAIDU_MAP_AK=你复制的AK
#
# ⚠️ `VITE_` 前缀意味着它会被打进前端 bundle。浏览器端 AK 本来就是公开值（安全边界在
#    Referer 白名单），但**不要**在这套机制里放任何服务端密钥。
#    未配置时地图自动降级为文字卡片，不影响其它功能。
# --------------------------------------------------------------------------
VITE_BAIDU_MAP_AK=

# --------------------------------------------------------------------------
# 演示账号口令（仅本地开发用）
#   登录页「角色卡片」点击后自动预填的密码，对应 backend/sql/V2__seed_data.sql
#   种出来的种子账号。生产构建里 import.meta.env.DEV 为 false，不会生效。
#   与后端 fixture_credentials.py 的默认值保持一致，改一处记得改另一处。
# --------------------------------------------------------------------------
VITE_DEMO_PASSWORD=Nl@123456
