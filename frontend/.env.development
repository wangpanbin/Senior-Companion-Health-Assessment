# ==========================================================================
# 开发环境变量（Vite 只暴露 VITE_ 前缀的变量给前端代码）
# ==========================================================================

# 应用标题
VITE_APP_TITLE=银龄伴诊

# 前端 dev server 端口
# 注意：5173 落在 Windows 被 Hyper-V/WSL2 保留的排除端口段（5152-5251）内，
# 非管理员进程绑定会报 EACCES，故改用 5141。
VITE_PORT=5141

# 后端地址（用于 vite 代理）
VITE_API_TARGET=http://localhost:8080

# 接口基础路径（axios baseURL）
VITE_API_BASE_URL=/api

# 是否开启调试日志
VITE_ENABLE_DEBUG=true

# --------------------------------------------------------------------------
# 演示账号口令（仅本地开发用）
#   登录页「角色卡片」点击后自动预填的密码，对应 backend/sql/V2__seed_data.sql
#   种出来的种子账号。生产构建里 import.meta.env.DEV 为 false，不会生效。
#   与后端 fixture_credentials.py 的默认值保持一致，改一处记得改另一处。
# --------------------------------------------------------------------------
VITE_DEMO_PASSWORD=Nl@123456