# ==========================================================================
# 生产环境变量
# 生产环境由 Nginx 反向代理 /api 到后端，因此 baseURL 保持相对路径
# ==========================================================================

VITE_APP_TITLE=银龄伴诊

VITE_API_BASE_URL=/api

VITE_ENABLE_DEBUG=false

# --------------------------------------------------------------------------
# 百度地图 AK（ADR-0022）
#
# 生产环境由部署流程注入（CI secret / 服务器环境变量），**不要把真值写进本文件**。
# 本地开发请写到 `frontend/.env.development.local`（`.gitignore` 已忽略 `*.local`）。
# 未配置时地图自动降级为文字卡片（只显示「距医院直线约 x 公里」），不影响其它功能。
# 申请方式见 `.env.development` 同名字段上的注释。
# --------------------------------------------------------------------------
VITE_BAIDU_MAP_AK=
