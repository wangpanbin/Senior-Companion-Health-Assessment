# ai-service · 环境变量样例
#
# ⚠️ 本文件只放**占位符**，不放任何真实值。
#    复制成 .env 后自行填值；.env 不入库（见 .gitignore）。
#
# ── 大模型（全部可留空 = 降级模式）────────────────────────────────────
# 不配 LLM_BASE_URL 时，助手照常可用，只是回答直接给 FAQ 原文（degraded=true）。
# 这是**正常模式，不是错误** —— 断网、没 key、没模型都不能让功能不可用。

# OpenAI 兼容端点。留空 = 降级模式。
#   云端示例： https://dashscope.aliyuncs.com/compatible-mode/v1
#   本地 Ollama：http://127.0.0.1:11434/v1
LLM_BASE_URL=

# API Key。Ollama 场景填任意占位串（如 ollama），云端填真实 key。
LLM_API_KEY=

# 模型名。留空时即使配了 BASE_URL 也会走降级（不报错，避免半套配置静默空转）。
LLM_MODEL=

# 单次调用超时（秒）
LLM_TIMEOUT_SECONDS=30

# ── 共享合规资产（与 Java 侧读同样的文件）────────────────────────────
# 留空 = 用仓库默认位置（../backend/src/main/resources/compliance/ 下）
# 生产部署时把**同一份文件**挂给 Java 与 Python 两个服务。
# ⚠️ 写在 .env 里是有效的：路径经 pydantic-settings 读取（.env 与环境变量都会读）。
NIANGLIN_COMPLIANCE_WORDS_PATH=
NIANGLIN_SENSITIVE_WORDS_PATH=
NIANGLIN_REFUSAL_TEMPLATE_PATH=

# ── FAQ 知识库 ────────────────────────────────────────────────────────
# 留空 = knowledge/faq.json（相对 ai-service/ 目录）
NIANGLIN_FAQ_PATH=
