        "id": 1001,
        "status": "PENDING",
        "statusLabel": "待接单",
        "hospital": "海南省人民医院",
        "department": "心血管内科",
        "visitTime": "2026-10-28 09:30:00"
      },
      "candidates": [
        {
          "companionId": 301,
          "companionName": "李*军",
